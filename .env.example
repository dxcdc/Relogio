# ============================================================
# .env.example — CDC Core
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA suba o arquivo .env para o Git.
# ============================================================

# ------ Django Core ------
SECRET_KEY=<DJANGO_SECRET_KEY>
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ------ Banco de Dados (PostgreSQL / Neon) ------
DATABASE_URL=postgres://<USER>:<PASSWORD>@<HOST>/<DBNAME>

# ------ Cloudinary (Upload de Mídia) ------
CLOUDINARY_CLOUD_NAME=<CLOUD_NAME>
CLOUDINARY_API_KEY=<API_KEY>
CLOUDINARY_API_SECRET=<API_SECRET>

# ------ E-mail (Resend / Anymail) ------
RESEND_API_KEY=<RESEND_API_KEY>
DEFAULT_FROM_EMAIL=no-reply@seudominio.com

# ------ Firebase Cloud Messaging (Push Notifications) ------
FIREBASE_CREDENTIALS_JSON=<CAMINHO_PARA_O_credentials.json>

# ------ Google OAuth / Gmail ------
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=https://<SEU_DOMINIO>/auth/google/callback

# ------ AWS S3 (caso use django-storages) ------
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>
AWS_STORAGE_BUCKET_NAME=<BUCKET_NAME>
AWS_S3_REGION_NAME=<REGION>

# ------ Segurança ------
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1
