# ============================================================
# .gitignore — CDC Core (Django)
# ============================================================

# ------ Variáveis de ambiente & Segredos ------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials.json
token.json

# ------ Python ------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-log.txt
pip-delete-this-directory.txt

# ------ Virtualenv ------
venv/
env/
.venv/
ENV/

# ------ Django ------
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
static_collected/

# ------ Uploads de mídia (não versionar) ------
/media/**
!/media/.gitkeep

# ------ Testes & Cobertura ------
htmlcov/
.tox/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# ------ IDE ------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ------ Ferramentas de build ------
node_modules/
*.min.js.map
dist/

# ------ Arquivos temporários / scratch ------
scratch/
*.tmp
*.bak

# ------ Templates Django (não versionar) ------
templates/
!templates/.gitkeep
